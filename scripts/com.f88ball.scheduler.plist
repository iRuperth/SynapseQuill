<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd service that keeps the World Cup scheduler running in the background.
  This is a TEMPLATE: __PROJECT_DIR__ is substituted with the repo's real path
  by scripts/f88ball_scheduler_ctl.sh at `install` time (do not `cp` it directly
  or the placeholder won't be resolved). Starts at login, restarts on crash.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.f88ball.scheduler</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__PROJECT_DIR__/scripts/f88ball_scheduler.sh</string>
    </array>

    <!-- Start at login and keep it alive: relaunch if it ever exits/crashes. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- Don't hammer if it crash-loops: wait 30s between restarts. -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>WorkingDirectory</key>
    <string>__PROJECT_DIR__</string>

    <!-- Logs so you can see what it's doing / any errors. Keep these OUT of
         ~/Documents: that tree is TCC-protected on macOS and launchd's daemon
         context can be denied opening a log file there (a com.apple.macl gets
         stamped on the file), which makes the job die at spawn with EX_CONFIG
         (78) and NO output. ~/Library/Logs is the standard, non-protected spot. -->
    <key>StandardOutPath</key>
    <string>/Users/rup/Library/Logs/f88ball/scheduler.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/rup/Library/Logs/f88ball/scheduler.err.log</string>
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd service that publishes generated videos to YouTube on a timer.
  TEMPLATE: __PROJECT_DIR__ is substituted with the repo's real path at install
  time (do not `cp` it directly or the placeholder won't be resolved).

  StartInterval rather than KeepAlive: this job is meant to RUN AND EXIT. The
  YouTube API allows roughly six uploads a day, so a process that stayed alive
  would spend the day sleeping. Waking on a timer, publishing what the quota
  permits and exiting is the honest shape for it, and it means a crash costs
  one cycle rather than the whole backlog.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.f88ball.uploader</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__PROJECT_DIR__/scripts/f88ball_uploader.sh</string>
    </array>

    <!-- One minute, so a finished recap reaches the channel while the result is
         still news. A match that lands seconds after a pass used to wait a full
         quarter of an hour for the next one.

         Nothing scales with this number the way it looks like it should:

         An idle pass opens no connection, imports no Google library and spends
         no quota — it lists a directory, reads a few JSON records and exits in
         under a tenth of a second, which is 0.1% of one core on a ten-core
         machine even at this interval.

         Nor does it multiply scraping. Both upstream sources are bounded by
         their OWN cache rather than by how often they are asked: ESPN holds a
         finished day for six hours, and roninfc.fans — a small supporters site
         that deserves the care — serves every date out of ONE listing document
         held for fifteen minutes, so ordering a queued digest costs that site
         at most four requests an hour whether we wake sixty times in it or four.

         And passes cannot pile up: the run takes an exclusive lock and a second
         one exits immediately rather than publishing the same backlog twice. -->
    <key>StartInterval</key>
    <integer>60</integer>

    <!-- Run once at load too, so installing it starts publishing immediately
         rather than a cycle later. -->
    <key>RunAtLoad</key>
    <true/>

    <key>WorkingDirectory</key>
    <string>__PROJECT_DIR__</string>

    <!-- Logs OUTSIDE ~/Documents: that tree is TCC-protected and launchd can be
         denied opening a file there, which kills the job at spawn with
         EX_CONFIG (78) and no output at all. -->
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/f88ball/uploader.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/f88ball/uploader.err.log</string>
</dict>
</plist>

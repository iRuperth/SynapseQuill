# ────────────────────────────────────────────────────────────────
# SynapseQuill — global environment template
# Copy to `.env` and fill in. Per-profile overrides live in
# profiles/<id>/.env (which win over these global values).
# ────────────────────────────────────────────────────────────────

# ===== LLM providers (text generation) =====
# At least ONE is required. Groq is the recommended free default.
LLM_PROVIDER=groq                       # groq | gemini | cerebras | ollama
GROQ_API_KEY=                           # https://console.groq.com  (free, no card)
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=                         # https://aistudio.google.com  (free tier)
GEMINI_MODEL=gemini-2.5-flash
CEREBRAS_API_KEY=                       # https://cloud.cerebras.ai  (free, 1M tok/day)
CEREBRAS_MODEL=llama-3.3-70b
OLLAMA_HOST=http://localhost:11434      # local, no key
OLLAMA_MODEL=qwen2.5:7b

# ===== Football data (FIFA World Cup 2026) =====
APIFOOTBALL_KEY=                        # https://dashboard.api-football.com (free 100/day)
APIFOOTBALL_LEAGUE=1                    # 1 = FIFA World Cup
APIFOOTBALL_SEASON=2026
FOOTBALL_DATA_TOKEN=                    # https://football-data.org (free fallback)

# ===== Visual media =====
IMAGE_PROVIDER=pollinations             # pollinations | cloudflare | hf_inference | local_diffusers
MEDIA_SOURCES=stock,graphics,flux       # comma-separated, order = layering priority
PEXELS_API_KEY=                         # https://www.pexels.com/api (free, optional stock)
CF_ACCOUNT_ID=                          # Cloudflare Workers AI (optional image fallback)
CF_API_TOKEN=
HF_TOKEN=                               # HuggingFace Inference (optional)

# ===== Voice (TTS) =====
TTS_PROVIDER=edge                       # edge | gtts | piper
TTS_VOICE=es-ES-AlvaroNeural            # e.g. es-AR-TomasNeural, es-MX-JorgeNeural
TTS_RATE=+8%                            # speech rate for excitement

# ===== YouTube upload (OAuth) =====
PRACTICE_MODE=true                      # true -> always upload as private (testing)
YOUTUBE_PRIVACY=private                 # private | unlisted | public

# ===== Trazabilidad =====
LANGSMITH_TRACING=false                 # true to enable
LANGSMITH_API_KEY=                      # https://smith.langchain.com (free 5k traces/mo)
LANGSMITH_PROJECT=synapsequill

# ===== Finance news (advanced level) =====
FINNHUB_API_KEY=                        # https://finnhub.io (free 60/min)

# ===== Content language =====
LANGUAGE=es                             # es | en | fr | it

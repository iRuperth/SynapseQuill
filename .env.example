# ────────────────────────────────────────────────────────────────
# F88tball — global environment template
# Copy to `.env` and fill in. Per-profile overrides live in
# profiles/<id>/.env (which win over these global values).
# ────────────────────────────────────────────────────────────────

# ===== LLM providers (text generation) =====
# At least ONE is required. Groq is the recommended free default.
LLM_PROVIDER=groq                       # groq | gemini | cerebras | ollama
GROQ_API_KEY=                           # https://console.groq.com  (free, no card)
GROQ_MODEL=openai/gpt-oss-120b          # llama-3.3-70b-versatile was retired by Groq
GEMINI_API_KEY=                         # https://aistudio.google.com  (free tier)
GEMINI_MODEL=gemini-2.5-flash
CEREBRAS_API_KEY=                       # https://cloud.cerebras.ai  (free tier)
CEREBRAS_MODEL=gpt-oss-120b
DEEPSEEK_API_KEY=                       # https://platform.deepseek.com  (PAID, cheap)
DEEPSEEK_MODEL=deepseek-v4-pro
OLLAMA_HOST=http://localhost:11434      # local, no key
OLLAMA_MODEL=qwen2.5:7b

# The guardrail judge. It MUST be different weights from the narrator — a model
# re-reading its own prose misses its own mistakes — so on a single provider
# give it a model of its own rather than only a provider.
JUDGE_PROVIDER=groq
JUDGE_MODEL=openai/gpt-oss-20b

# Where a failed LLM call goes next, in order: "provider:model" steps, or a bare
# "provider" for that provider's configured model. Empty disables the chain.
# Worth knowing: Groq meters tokens-per-minute PER MODEL, so a step that only
# changes the model still buys a fresh budget rather than hitting the same wall.
# Free steps first, paid last, so an ordinary day costs nothing and only a
# matchday that outruns every free budget reaches the paid provider.
# Adding a second key to the SAME provider does not help: Groq (and most free
# tiers) meter per account, not per key. Budget comes from another provider.
LLM_FALLBACK_CHAIN=groq:qwen/qwen3.6-27b,deepseek,cerebras
LLM_RATELIMIT_WAIT=20                   # seconds to pause when every key is 429

# Background music. MUSIC_START skips into the track so the bed does not open on
# a song's quiet intro; it is clamped to the file length. Levels are relative to
# the narration - a bed 12-18 dB under the voice is audible without competing.
# MUSIC_TRACK=assets/music/your_track.mp3
# MUSIC_START=0
# MUSIC_VOLUME=0.22
# MUSIC_VOLUME_PEAK=0.30

# ===== Football data source =====
# DATA_PROVIDER chooses the API:
#   espn         -> CURRENT-season La Liga 2025/26 + World Cup 2026 with scorers
#                   and minutes, FREE, no key. Recommended default (always recent).
#   apifootball  -> full scorers but free plan only covers seasons 2021-2024.
#   thesportsdb  -> current scores (free key 123) but no scorers.
DATA_PROVIDER=espn
ESPN_LEAGUE_SLUG=esp.1                   # esp.1 = La Liga · fifa.world = World Cup

# --- API-Football (apifootball, optional) ---
APIFOOTBALL_KEY=                        # https://dashboard.api-football.com (free 100/day)
APIFOOTBALL_LEAGUE=140                  # 140 = La Liga
APIFOOTBALL_SEASON=2023

# --- TheSportsDB (thesportsdb) — for the World Cup 2026 ---
THESPORTSDB_KEY=123                     # free public test key, no card
THESPORTSDB_LEAGUE=4429                 # 4429 = FIFA World Cup
THESPORTSDB_SEASON=2026

# Enrich scores with scorers+minutes from ESPN's free public API when the data
# source has none (e.g. World Cup via TheSportsDB). true | false
ESPN_ENRICH=true

# MATCH_MODE controls which matches the dashboard shows by default:
#   today   -> fixtures of the current date (use for a live competition)
#   latest  -> most recent finished matches (use for past seasons / demos)
MATCH_MODE=latest
FOOTBALL_DATA_TOKEN=                    # https://football-data.org (free fallback, optional)

# ===== Visual media =====
IMAGE_PROVIDER=pollinations             # pollinations | cloudflare | hf_inference | local_diffusers
# graphics = animated scoreboard+goals (free, local). Add 'flux' for AI ambience
# (needs a working image provider; Pollinations free tier is no longer available).
MEDIA_SOURCES=graphics
PEXELS_API_KEY=                         # https://www.pexels.com/api (free, optional stock)
CF_ACCOUNT_ID=                          # Cloudflare Workers AI (optional image fallback)
CF_API_TOKEN=
HF_TOKEN=                               # HuggingFace Inference (optional)

# ===== Voice (TTS) =====
TTS_PROVIDER=edge                       # edge | gtts | piper
TTS_VOICE=es-ES-AlvaroNeural            # e.g. es-AR-TomasNeural, es-MX-JorgeNeural
TTS_RATE=+8%                            # speech rate for excitement

# ===== YouTube upload (OAuth) =====
PRACTICE_MODE=true                      # true -> always upload as private (testing)
YOUTUBE_PRIVACY=private                 # private | unlisted | public

# ===== Trazabilidad =====
LANGSMITH_TRACING=false                 # true to enable
LANGSMITH_API_KEY=                      # https://smith.langchain.com (free 5k traces/mo)
LANGSMITH_PROJECT=f88tball

# ===== Finance news (advanced level) =====
FINNHUB_API_KEY=                        # https://finnhub.io (free 60/min)

# ===== Content language =====
LANGUAGE=es                             # es | en | fr | it
